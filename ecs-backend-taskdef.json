        { "name": "KAKAO_CLIENT_SECRET", "value": "wMmkAB0cy35vYOkIivFNn6DWTw1PK8tZ" },
        { "name": "DATABASE_URL", "value": "postgresql://dello:roemflq3308@service-project.cluster-c30wmecm0n18.ap-northeast-2.rds.amazonaws.com:5432/service_project?sslmode=require&sslrootcert=%2Fetc%2Fssl%2Fcerts%2Fca-certificates.crt" },
