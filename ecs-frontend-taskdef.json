{
  "family": "service-project-frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::730335665321:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "730335665321.dkr.ecr.ap-northeast-2.amazonaws.com/service-project-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "NEXT_PUBLIC_API_URL", "value": "https://www.worktogether.it.kr" },
        { "name": "NEXT_PUBLIC_WEATHER_KEY", "value": "80fbb018ce56e7ecfff5d39c15b5084f005e37c832abcd3bffcb28b5ed481328" },
        { "name": "KAKAO_REST_API_KEY", "value": "f973aa86ba20579045fa02c8954565b1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/service-project-frontend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
